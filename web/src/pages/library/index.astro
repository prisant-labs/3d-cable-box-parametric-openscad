---
// Preset browser. One card per preset, filterable by what a visitor actually
// asks: "will it fit my printer" and "does it do Gridfinity".
//
// Cards use the box-and-lid render deliberately. That is the one view
// build_library.py renders at a fixed camera distance rather than --viewall, so
// the grid reads as a size comparison; five of the nine presets differ only in
// dimensions and a per-card zoom-to-fit would hide the only difference they have.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	library,
	presets,
	libraryUrl,
	formatSize,
	featureLabels,
} from '../../lib/library';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const partSize = (preset: (typeof presets)[number], slug: string) =>
	preset.parts.find((p) => p.slug === slug)?.size_mm ?? null;

// The longest side that has to fit on a printer bed, in mm, or undefined when
// the index does not say. A square bed takes a part either way round, so the
// longest side of the largest separately printed part decides.
//
// The lid prints on its own and is 2 * (Wall_Thickness + Lid_Lip_Gap) larger
// than the box each way, 4 mm at the defaults, so it is usually the part that
// decides. Comparing the box alone passed under-desk-passthrough (a 180 mm box)
// for a 180 mm bed, although its 184 mm lid does not fit one.
//
// A sliced preset's box_size_mm is the preview layout, every piece side by
// side, so largest_piece_mm stands in for the box. That figure is measured from
// the box's pieces only. The lid's pieces are as deep as the whole lid, which
// is counted here, but their width is not in the index.
function bedFit(preset: (typeof presets)[number]): number | undefined {
	const lid = partSize(preset, 'lid-only');
	if (preset.features.sliced) {
		const piece = preset.largest_piece_mm;
		if (!piece) return undefined;
		return Math.max(piece[0], piece[1], lid ? lid[1] : 0);
	}
	const box = partSize(preset, 'box-only') ?? preset.box_size_mm;
	if (!box) return undefined;
	return Math.max(box[0], box[1], lid ? lid[0] : 0, lid ? lid[1] : 0);
}

const cards = presets.map((preset) => {
	const card = preset.parts.find((p) => p.slug === 'box-and-lid') ?? preset.parts[0];
	return { preset, image: card?.image ?? null, fit: bedFit(preset) };
});

// The footprint chart draws every box from above at one scale, in a square
// cell this many millimetres across. It covers the largest preset with room
// for a 300 mm bed outline; a larger bed grows every cell together.
const CHART_CELL_MM = 300;
const footprints = presets.map((preset) => {
	const [w, d] = preset.assembled_size_mm ?? preset.box_size_mm ?? [0, 0];
	const lid = partSize(preset, 'lid-only');
	// A sliced preset's lid size is also the preview layout, so draw its lid
	// from the assembled box plus the same margin a whole lid adds.
	const lidPad = lid && !preset.features.sliced ? (lid[0] - w) / 2 : 2;
	return {
		preset,
		w,
		d,
		lidPad,
		seams: preset.features.sliced ? (preset.features.slice_count ?? 2) : 1,
		fit: bedFit(preset),
	};
});
---

<StarlightPage
	frontmatter={{
		title: 'Preset library',
		description:
			'Ready-to-print cable box configurations, with 3D previews and downloads.',
	}}
>
	<p>
		Nine configurations built from the same model, each sized for something you
		already own. Every file below is generated by <code
			>scripts/build_library.py</code
		> from <code>cable-box-parametric.scad</code> at version {library.model_version},
		so nothing here can drift from the model.
	</p>

	<form class="filters" id="filters">
		<label class="bed">
			Printer bed (mm)
			<input type="number" id="bed" min="50" max="1000" step="10" placeholder="any" />
		</label>
		<span class="toggles">
			<label><input type="checkbox" data-filter="gridfinity" /> Gridfinity</label>
			<label><input type="checkbox" data-filter="sliced" /> Splits for a small bed</label>
			<label><input type="checkbox" data-filter="nopost" /> Clear interior</label>
		</span>
		<output id="count"></output>
	</form>

	<ul class="grid">
		{
			cards.map(({ preset, image, fit }) => (
				<li
					class="card"
					data-fit={fit}
					data-gridfinity={String(
						preset.features.gridfinity_bottom || preset.features.gridfinity_lid_top,
					)}
					data-sliced={String(preset.features.sliced)}
					data-nopost={String(!preset.features.post)}
				>
					<a href={`${base}/library/${preset.name}/`}>
						{image && (
							<img
								src={libraryUrl(base, image.path)}
								alt={`${preset.title}, box and lid`}
								loading="lazy"
								width="1000"
								height="750"
							/>
						)}
						<strong>{preset.title}</strong>
					</a>
					<p class="fits">{preset.fits}</p>
					<p class="size">{formatSize(preset.assembled_size_mm ?? preset.box_size_mm)}</p>
					{featureLabels(preset.features).length > 0 && (
						<p class="badges">
							{featureLabels(preset.features).map((label) => (
								<span class="badge">{label}</span>
							))}
						</p>
					)}
				</li>
			))
		}
	</ul>
	<p class="empty" id="empty" hidden>
		No preset matches those filters. The model is parametric: start from the
		closest preset and change the dimensions.
	</p>

	<h2 id="footprints">Footprints to scale</h2>
	<p>
		Each preset seen from above, all at one scale. The dark shape is the box,
		and the light outline around it is the lid, which prints on its own and is
		slightly larger. A sliced preset shows its seams, because each piece prints
		separately. Enter a printer bed size above, and a dashed square of that
		size appears over every preset: red where a part will not fit.
	</p>
	<ul class="footprints" data-cell={CHART_CELL_MM}>
		{
			footprints.map(({ preset, w, d, lidPad, seams, fit }) => (
				<li data-fit={fit}>
					<svg
						viewBox={`${-CHART_CELL_MM / 2} ${-CHART_CELL_MM / 2} ${CHART_CELL_MM} ${CHART_CELL_MM}`}
						role="img"
						aria-label={`${preset.title}: ${w} by ${d} mm from above`}
					>
						<rect
							class="lid"
							x={-w / 2 - lidPad}
							y={-d / 2 - lidPad}
							width={w + 2 * lidPad}
							height={d + 2 * lidPad}
							rx="6"
						/>
						<rect class="box" x={-w / 2} y={-d / 2} width={w} height={d} rx="5" />
						{Array.from({ length: seams - 1 }, (_, i) => {
							const x = -w / 2 + ((i + 1) * w) / seams;
							return <line class="seam" x1={x} x2={x} y1={-d / 2 - lidPad} y2={d / 2 + lidPad} />;
						})}
						<rect class="bed" display="none" x="0" y="0" width="0" height="0" />
					</svg>
					<a href={`${base}/library/${preset.name}/`}>{preset.title}</a>
					<span class="size">{w} x {d} mm</span>
				</li>
			))
		}
	</ul>
</StarlightPage>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
		margin: 1.5rem 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, transparent);
	}
	.filters label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
	}
	.filters .toggles {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.filters input[type='number'] {
		width: 6rem;
		padding: 0.2rem 0.4rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
	}
	#count {
		margin-inline-start: auto;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.grid {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
	}
	.card {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.75rem;
		margin: 0;
	}
	.card a {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.card img {
		width: 100%;
		height: auto;
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
	}
	.card strong {
		display: block;
		margin-top: 0.5rem;
		color: var(--sl-color-white);
	}
	.card a:hover strong {
		color: var(--sl-color-text-accent);
	}
	.card p {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.card .size {
		font-family: var(--sl-font-mono, monospace);
		color: var(--sl-color-gray-3);
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.badge {
		font-size: var(--sl-text-xs);
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
	}
	.empty {
		margin-top: 1rem;
		font-style: italic;
	}

	.footprints {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
	}
	.footprints li {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: var(--sl-text-sm);
	}
	.footprints svg {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		/* A faint 50 mm grid, drawn as a background so it scales with the cell. */
		background-image:
			linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
			linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
		background-size: calc(100% / 6) calc(100% / 6);
		background-position: center;
	}
	.footprints .lid {
		fill: none;
		stroke: #8fa6bf;
		stroke-width: 2;
	}
	.footprints .box {
		fill: #3e4c5e;
	}
	.footprints .seam {
		stroke: #f28c38;
		stroke-width: 2.5;
		stroke-dasharray: 6 4;
	}
	.footprints .bed {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 2.5;
		stroke-dasharray: 8 5;
	}
	.footprints li.over .bed {
		stroke: #dc2626;
	}
	.footprints .size {
		font-family: var(--sl-font-mono, monospace);
		color: var(--sl-color-gray-3);
	}
</style>

<script>
	// Filtering is progressive enhancement: the page ships every card in the
	// HTML, so with JavaScript off the library is still a complete, browsable
	// catalogue and only the narrowing is lost.
	const form = document.getElementById('filters') as HTMLFormElement | null;
	const bed = document.getElementById('bed') as HTMLInputElement | null;
	const count = document.getElementById('count') as HTMLOutputElement | null;
	const empty = document.getElementById('empty');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));

	function apply() {
		if (!form) return;
		const limit = bed?.value ? Number(bed.value) : Infinity;
		const wanted = Array.from(
			form.querySelectorAll<HTMLInputElement>('input[data-filter]:checked'),
		).map((input) => input.dataset.filter!);

		let shown = 0;
		for (const card of cards) {
			const matches = wanted.every((key) => card.dataset[key] === 'true');
			const visible = fits(card, limit) && matches;
			card.hidden = !visible;
			if (visible) shown += 1;
		}
		if (count) count.textContent = `${shown} of ${cards.length}`;
		if (empty) empty.hidden = shown !== 0;
		drawBed(bed?.value ? Number(bed.value) : null);
	}

	// data-fit is the longest side of the largest separately printed part (see
	// bedFit() in the frontmatter). It is absent when the index cannot say, as
	// for a sliced preset built without trimesh, and then the preset is shown
	// rather than hidden on data we do not have.
	function fits(el: HTMLElement, limit: number): boolean {
		return el.dataset.fit === undefined || Number(el.dataset.fit) <= limit;
	}

	// The footprint chart: one dashed bed outline per preset, at the chart's
	// scale. Every cell shares one viewBox, so a bed larger than the cell grows
	// all of them together and the presets stay comparable.
	const chart = document.querySelector<HTMLElement>('.footprints');
	const baseCell = Number(chart?.dataset.cell ?? 300);
	function drawBed(size: number | null) {
		if (!chart) return;
		const cell = size ? Math.max(baseCell, size + 20) : baseCell;
		for (const item of Array.from(chart.querySelectorAll<HTMLElement>('li'))) {
			const svg = item.querySelector('svg');
			const rect = item.querySelector<SVGRectElement>('.bed');
			if (!svg || !rect) continue;
			svg.setAttribute('viewBox', `${-cell / 2} ${-cell / 2} ${cell} ${cell}`);
			svg.style.backgroundSize = `${(100 * 50) / cell}% ${(100 * 50) / cell}%`;
			if (!size) {
				rect.setAttribute('display', 'none');
				item.classList.remove('over');
				continue;
			}
			rect.removeAttribute('display');
			for (const [k, v] of [['x', -size / 2], ['y', -size / 2], ['width', size], ['height', size]] as const)
				rect.setAttribute(k, String(v));
			item.classList.toggle('over', !fits(item, size));
		}
	}

	form?.addEventListener('input', apply);
	form?.addEventListener('submit', (event) => event.preventDefault());
	apply();
</script>
