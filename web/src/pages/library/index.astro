---
// Preset browser. One card per preset, filterable by what a visitor actually
// asks: "will it fit my printer" and "does it do Gridfinity".
//
// Cards use the box-and-lid render deliberately. That is the one view
// build_library.py renders at a fixed camera distance rather than --viewall, so
// the grid reads as a size comparison; five of the nine presets differ only in
// dimensions and a per-card zoom-to-fit would hide the only difference they have.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	library,
	presets,
	libraryUrl,
	formatSize,
	featureLabels,
} from '../../lib/library';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const cards = presets.map((preset) => {
	const card = preset.parts.find((p) => p.slug === 'box-and-lid') ?? preset.parts[0];
	const [w, d] = preset.box_size_mm ?? [0, 0];
	return { preset, image: card?.image ?? null, w, d };
});
---

<StarlightPage
	frontmatter={{
		title: 'Preset library',
		description:
			'Ready-to-print cable box configurations, with 3D previews and downloads.',
	}}
>
	<p>
		Nine configurations built from the same model, each sized for something you
		already own. Every file below is generated by <code
			>scripts/build_library.py</code
		> from <code>cable-box-parametric.scad</code> at version {library.model_version},
		so nothing here can drift from the model.
	</p>

	<form class="filters" id="filters">
		<label class="bed">
			Printer bed (mm)
			<input type="number" id="bed" min="50" max="1000" step="10" placeholder="any" />
		</label>
		<span class="toggles">
			<label><input type="checkbox" data-filter="gridfinity" /> Gridfinity</label>
			<label><input type="checkbox" data-filter="sliced" /> Splits for a small bed</label>
			<label><input type="checkbox" data-filter="nopost" /> Clear interior</label>
		</span>
		<output id="count"></output>
	</form>

	<ul class="grid">
		{
			cards.map(({ preset, image, w, d }) => (
				<li
					class="card"
					data-w={w}
					data-d={d}
					data-gridfinity={String(
						preset.features.gridfinity_bottom || preset.features.gridfinity_lid_top,
					)}
					data-sliced={String(preset.features.sliced)}
					data-nopost={String(!preset.features.post)}
				>
					<a href={`${base}/library/${preset.name}/`}>
						{image && (
							<img
								src={libraryUrl(base, image.path)}
								alt={`${preset.title}, box and lid`}
								loading="lazy"
								width="1000"
								height="750"
							/>
						)}
						<strong>{preset.title}</strong>
					</a>
					<p class="fits">{preset.fits}</p>
					<p class="size">{formatSize(preset.box_size_mm)}</p>
					{featureLabels(preset.features).length > 0 && (
						<p class="badges">
							{featureLabels(preset.features).map((label) => (
								<span class="badge">{label}</span>
							))}
						</p>
					)}
				</li>
			))
		}
	</ul>
	<p class="empty" id="empty" hidden>
		No preset matches those filters. The model is parametric: start from the
		closest preset and change the dimensions.
	</p>
</StarlightPage>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
		margin: 1.5rem 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, transparent);
	}
	.filters label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
	}
	.filters .toggles {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.filters input[type='number'] {
		width: 6rem;
		padding: 0.2rem 0.4rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
	}
	#count {
		margin-inline-start: auto;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.grid {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
	}
	.card {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.75rem;
		margin: 0;
	}
	.card a {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.card img {
		width: 100%;
		height: auto;
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
	}
	.card strong {
		display: block;
		margin-top: 0.5rem;
		color: var(--sl-color-white);
	}
	.card a:hover strong {
		color: var(--sl-color-text-accent);
	}
	.card p {
		margin: 0.35rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.card .size {
		font-family: var(--sl-font-mono, monospace);
		color: var(--sl-color-gray-3);
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.badge {
		font-size: var(--sl-text-xs);
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
	}
	.empty {
		margin-top: 1rem;
		font-style: italic;
	}
</style>

<script>
	// Filtering is progressive enhancement: the page ships every card in the
	// HTML, so with JavaScript off the library is still a complete, browsable
	// catalogue and only the narrowing is lost.
	const form = document.getElementById('filters') as HTMLFormElement | null;
	const bed = document.getElementById('bed') as HTMLInputElement | null;
	const count = document.getElementById('count') as HTMLOutputElement | null;
	const empty = document.getElementById('empty');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));

	function apply() {
		if (!form) return;
		const limit = bed?.value ? Number(bed.value) : Infinity;
		const wanted = Array.from(
			form.querySelectorAll<HTMLInputElement>('input[data-filter]:checked'),
		).map((input) => input.dataset.filter!);

		let shown = 0;
		for (const card of cards) {
			// A part is printable on the bed when its footprint fits either way
			// round, so compare the smaller dimension against the smaller limit.
			const w = Number(card.dataset.w);
			const d = Number(card.dataset.d);
			const fits = Math.max(w, d) <= limit || card.dataset.sliced === 'true';
			const matches = wanted.every((key) => card.dataset[key] === 'true');
			const visible = fits && matches;
			card.hidden = !visible;
			if (visible) shown += 1;
		}
		if (count) count.textContent = `${shown} of ${cards.length}`;
		if (empty) empty.hidden = shown !== 0;
	}

	form?.addEventListener('input', apply);
	form?.addEventListener('submit', (event) => event.preventDefault());
	apply();
</script>
