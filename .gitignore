# Private scratch, agent working notes, and session logs
_local/
_NOTES/
_jp-notes/
AGENTS/

# Local tool state
.memsearch/

# CAD outputs
*.stl
*.3mf
*.obj
*.amf
*.step
*.iges
*.glb
exports/
renders/
site/
ci-smoke-out/

# Keep curated release artifacts versionable in-library/examples.
# The library GLBs are the docs site's 3D previews, generated from the STLs
# beside them; tracking them keeps the Pages build Node-only.
!library/**/*.stl
!library/**/*.glb
!examples/**/*.stl

# Tool/editor/system files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
*.bak
*.stackdump

# Generated standalone bundle
dist/

# Claude Code worktrees
.claude/worktrees/

# Python bytecode
__pycache__/
*.pyc

# Docs site (web/): toolchain, build output, and content synced from docs/ by
# web/sync-docs.mjs. The synced copies are generated artifacts; docs/ is the
# single source of truth.
web/node_modules/
web/dist/
web/.astro/
web/src/content/docs/
web/public/options-guide.html
web/public/library/
