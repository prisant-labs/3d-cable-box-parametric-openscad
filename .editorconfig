root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{scad,py}]
indent_size = 4

# The docs site's own code is tab-indented.
[web/**.{mjs,js,ts,astro}]
indent_style = tab
